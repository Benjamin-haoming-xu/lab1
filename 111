#include <iostream>
#include <string>
#include <vector>
#include <fstream>

using namespace std;

int main()
{
    vector<int> V;
    ifstream    file;
    file.open("numbers.txt");
    
    while(true) {
        int x;
        
        file >> x;
        
        if (file.fail()) {
            break;
        }
        
        V.push_back(x);
    }
    
    cout << "# of values:" << V.size() << endl;
    
    int sum = 0;
    for (int x : V) {
        sum = sum + x;
    }    
        cout << "The sum is:" << sum << endl;
    
    double mean = static_cast<double>(sum) / V.size();
    
    cout << "The mean is:" << mean << endl;

    for (int x : V) {
        k = x - mean;
        K.push_back(k);

        int dev = 0;
        for (int y : K) { 
            dev = dev + pow(y,2);
            standard_deviation = dev / V.size();
        cout << "The standard deviation is:" << standard_deviation << endl;
            
    }
    
    return 0;
}
