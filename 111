#include <iostream>
#include <string>
#include <vector>
#include <fstream>
#include <cmath>

using namespace std;

int main()
{
    vector<int> V;
    ifstream    file;
    file.open("numbers.txt");
    
    while(true) {
        int x;
        
        file >> x;
        
        if (file.fail()) {
            break;
        }
        
        V.push_back(x);
    }
    
    cout << "# of values:" << V.size() << endl;
    
    int sum = 0;
    for (int x : V) {
        sum = sum + x;
    }    
        cout << "The sum is:" << sum << endl;
    
    double mean = static_cast<double>(sum) / V.size();
    
    cout << "The mean is:" << mean << endl;

    vector<double> K;
    for (int x : V) {
        double k = x - mean;
        K.push_back(k);
    }

    double diff = 0;
    for (double y : K) { 
        diff = diff + pow(y,2);
    }

    double standard_deviation = sqrt(diff / V.size());

    cout << "The standard deviation is:" << standard_deviation << endl;
            
    }
    
    return 0;
}
